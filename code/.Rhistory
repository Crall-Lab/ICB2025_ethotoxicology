hist_data <- hist(log10(all_distances), breaks = 100, plot = FALSE)
counts <- hist_data$counts
bin_edges <- hist_data$breaks
peaks <- which(diff(sign(diff(counts))) == -2) + 1
troughs <- which(diff(sign(diff(counts))) == 2) + 1
if (length(peaks) >= 2) {
peak1 <- peaks[1]
peak2 <- peaks[2]
troughs_between_peaks <- troughs[troughs > peak1 & troughs < peak2]
if (length(troughs_between_peaks) > 0) {
trough <- troughs_between_peaks[1]
trough_position <- (bin_edges[trough] + bin_edges[trough + 1]) / 2
