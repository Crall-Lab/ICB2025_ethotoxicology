process_file <- function(file) {
raw_data <- read.csv(file)
raw_data <- raw_data %>%
filter(complete.cases(ID, frame, centroidX, centroidY)) %>%
arrange(ID, frame)
distances <- raw_data %>%
group_by(ID) %>%
mutate(next_centroidX = lead(centroidX),
next_centroidY = lead(centroidY),
next_frame = lead(frame)) %>%
filter(abs(next_frame - frame) == 1) %>%
mutate(distance = calculate_distance(centroidX, centroidY, next_centroidX, next_centroidY)) %>%
filter(distance != 0) %>%
pull(distance)
return(distances)
}
all_distances <- file_list %>%
map(process_file) %>%
unlist()
hist(all_distances)
hist(log(all_distances))
process_file <- function(file) {
tryCatch({
raw_data <- read.csv(file)
raw_data <- raw_data %>%
filter(complete.cases(ID, frame, centroidX, centroidY)) %>%
arrange(ID, frame)
distances <- raw_data %>%
group_by(ID) %>%
mutate(next_centroidX = lead(centroidX),
next_centroidY = lead(centroidY),
next_frame = lead(frame)) %>%
filter(abs(next_frame - frame) == 1) %>%
mutate(distance = calculate_distance(centroidX, centroidY, next_centroidX, next_centroidY)) %>%
filter(distance != 0) %>%
pull(distance)
return(distances)
}, error = function(e) {
message(paste("Error in file:", file, ":", e$message))
return(NULL)
})
}
