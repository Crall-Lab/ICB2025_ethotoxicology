process_file <- function(file) {
raw_data <- read.csv(file)
raw_data <- raw_data %>%
filter(complete.cases(ID, frame, centroidX, centroidY)) %>%
arrange(ID, frame)
distances <- raw_data %>%
group_by(ID) %>%
mutate(next_centroidX = lead(centroidX),
next_centroidY = lead(centroidY),
next_frame = lead(frame)) %>%
filter(abs(next_frame - frame) == 1) %>%
mutate(distance = calculate_distance(centroidX, centroidY, next_centroidX, next_centroidY)) %>%
filter(distance != 0) %>%
pull(distance)
return(distances)
}
all_distances <- file_list %>%
map(process_file) %>%
unlist()
hist(all_distances)
all_distances <- file_list %>%
map(process_file) %>%
unlist()
hist(all_distances)
# Load necessary libraries
library(dplyr)
library(purrr)
# Function to calculate distance
calculate_distance <- function(x1, y1, x2, y2) {
sqrt((x2 - x1)^2 + (y2 - y1)^2)
}
# Set the path to your directory
dir <- "/Volumes/Expansion/hoophouse2023/nestPi/aug31tosep3/raspberrypi_2023-08-31"
# Get a list of all files ending with _raw.csv in the subfolder
file_list <- list.files(path = dir, pattern = "*_raw.csv", full.names = TRUE)
# Initialize an empty vector to store distances
all_distances <- c()
process_file <- function(file) {
raw_data <- read.csv(file)
raw_data <- raw_data %>%
filter(complete.cases(ID, frame, centroidX, centroidY)) %>%
arrange(ID, frame)
distances <- raw_data %>%
group_by(ID) %>%
mutate(next_centroidX = lead(centroidX),
next_centroidY = lead(centroidY),
next_frame = lead(frame)) %>%
filter(abs(next_frame - frame) == 1) %>%
mutate(distance = calculate_distance(centroidX, centroidY, next_centroidX, next_centroidY)) %>%
filter(distance != 0) %>%
pull(distance)
return(distances)
}
all_distances <- file_list %>%
map(process_file) %>%
