hist(all_distances)
# Set the path to your directory
dir <- "/Volumes/Expansion/hoophouse2023/nestPi/sep10to13/raspberrypi_2023-09-12"
# Get a list of all files ending with _raw.csv in the subfolder
file_list <- list.files(path = dir, pattern = "*_raw.csv", full.names = TRUE)
# Initialize an empty vector to store distances
all_distances <- c()
# Loop through each file
for (file in file_list) {
# Read the raw tracking data
raw_data <- read.csv(file)
# Initialize an empty vector to store distances for the current file
distances <- c()
# Nested loops to check each row against every other row
for (i in 1:(nrow(raw_data) - 1)) {
for (j in (i + 1):nrow(raw_data)) {
if (raw_data$ID[i] == raw_data$ID[j] &&
abs(raw_data$frame[j] - raw_data$frame[i]) == 1) {
# Calculate distance
dist <- calculate_distance(raw_data$centroidX[i], raw_data$centroidY[i],
raw_data$centroidX[j], raw_data$centroidY[j])
if (dist != 0) {
distances <- c(distances, dist)
print(paste("Distance calculated for rows", i, "and", j, "in file", basename(file), ":", dist))
}
# Append distances from the current file to the all_distances vector
all_distances <- c(all_distances, distances)
}
hist(all_distances)
process_file <- function(file) {
raw_data <- read.csv(file)
raw_data <- raw_data %>%
filter(complete.cases(ID, frame, centroidX, centroidY)) %>%
arrange(ID, frame)
distances <- raw_data %>%
group_by(ID) %>%
mutate(next_centroidX = lead(centroidX),
next_centroidY = lead(centroidY),
next_frame = lead(frame)) %>%
filter(abs(next_frame - frame) == 1) %>%
mutate(distance = calculate_distance(centroidX, centroidY, next_centroidX, next_centroidY)) %>%
filter(distance != 0) %>%
pull(distance)
return(distances)
}
