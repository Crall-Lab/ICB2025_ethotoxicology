if (length(troughs_between_peaks) > 0) {
trough <- troughs_between_peaks[1]
trough_position <- (bin_edges[trough] + bin_edges[trough + 1]) / 2
# Plot the histogram with the trough line
hist(filtered_distance_data$distances, breaks = 30, main = "Bimodal Distribution of Distances (Filtered < 50)",
xlab = "Distance", col = "blue")
abline(v = trough_position, col = "red", lty = 2, lwd = 2)
legend("topright", legend = paste("Trough at", round(trough_position, 2)), col = "red", lty = 2, lwd = 2)
