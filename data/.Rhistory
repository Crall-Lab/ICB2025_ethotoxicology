library(stringr)
library(bipartite)
library(lme4)
library(ggplot2)
setwd("~/Desktop/hoophouse2023/code")
setwd("~/Desktop/anupreksha/hoophouse2023/data")
#Read in flower visitation data
lst <- list.files(pattern = "FlowerTags.csv")
rm(list = 'flower_data')
for(file in lst){
fl_dat <-read.csv(file)
if(!exists('flower_data')){
flower_data <- fl_dat
} else {
flower_data <- rbind(flower_data, fl_dat)
}
#Read in tag data
tag_data <- read.csv('tag_metadata.csv')
#Camera metadata, from round 1
cam_metadata <- read.csv('flowersp_metadata.csv')
#Remove end brackets on tag data
flower_data$Tag.IDs <- str_sub(flower_data$Tag.IDs, 2, -2)
#Subset to data where some tags were detected
flower_data <- subset(flower_data, !(Tag.IDs == ""))
# Function to extract unique number sequence
# Function to extract unique number sequence using strsplit
# Function to extract unique number sequence without strsplit
extract_unique_sequence <- function(text) {
pattern <- "\\b001\\w{9}\\b" # Pattern to match '001' followed by 9 alphanumeric characters
matches <- regmatches(text, gregexpr(pattern, text))[[1]]
unique_matches <- unique(matches)
if(length(unique_matches) > 0) {
return(unique_matches)
} else {
return(NA)
}
flower_data$camera <- sapply(flower_data$Video, extract_unique_sequence)
#Loop over videos and count tags by trials
rm('out_data')
for(i in 1:length(flower_data[,1])){
tags <- as.data.frame(table(unlist(strsplit(gsub(" ", "",flower_data$Tag.IDs[i]), ','))))
colnames(tags) <- c("ID", "count")
tags$date.time <- paste(flower_data$Date[i], flower_data$Time[i], sep = "_")
tags$camera <- flower_data$camera[i]
if(!exists('out_data')){
out_data <- tags
} else{
out_data <- rbind(out_data, tags)
}
#Take tag lists from first three rows of tag data (round 1)
rm(list = 'taglist')
for(zz in 1:length(tag_data[,1])){
tags <- as.data.frame(seq(tag_data$tag_start[zz], tag_data$tag_end[zz]))
tags$treatment <- tag_data$treatment[zz]
tags$round <- tag_data$round[zz]
colnames(tags) <- c('ID', 'treatment', 'round')
if(zz == 1){
taglist <- tags
} else{
taglist <- rbind(taglist, tags)
}
#Subset to data with known tag IDs, excluding tag 17
#Optional additional quality control would be to remove any observations only one
out_data <- subset(out_data, ID %in% taglist$ID & !(ID == 17))
#Add treatment back in to data frame
for(trt in unique(taglist$treatment)){
out_data$treatment[out_data$ID %in% taglist$ID[taglist$treatment == trt]] <- trt
}
#Write flower species data into out_data
for(i in 1:length(cam_metadata[,1])){
out_data$species[out_data$camera == cam_metadata$camera[i]] <- cam_metadata$species[i]
}
counts_by_individual <- table(out_data$ID, out_data$species)
counts <- as.data.frame(cbind(rownames(counts_by_individual), counts_by_individual))
colnames(counts) <- c("ID", "borage", "cucumber", "zinnia")
counts <- subset(counts, ID %in% taglist$ID)
#Cap total number of visits
counts$total[counts$total > 100] <- 100
#Add treatment back in to data frame
for(trt in unique(taglist$treatment)){
counts$treatment[counts$ID %in% taglist$ID[taglist$treatment == trt]] <- trt
}
#Add round back in to data frame
for(rnd in unique(taglist$round)){
counts$round[counts$ID %in% taglist$ID[taglist$round == rnd]] <- rnd
}
#Convert counts to numeric
for(i in 2:4){
counts[,i] <- as.numeric(counts[,i])
}
#Get total counts
counts$total <- rowSums(counts[,2:4])
#Add whether bees foraged to taglist data
taglist$treatment <- as.factor(taglist$treatment)
taglist$round <- as.factor(taglist$round)
taglist$foraged <- as.numeric(taglist$ID %in% counts$ID)
#Replace outlier treatment labels (revisit this!)
counts$treatment[counts$treatment == 'sunflower_f'] <- 'flupyradifurone'
counts$treatment[counts$treatment == 'sunflower_i'] <- 'imidacloprid'
counts$treatment[counts$treatment == 'sunflower_c'] <- 'control'
counts <- subset(counts, treatment %in% c('control', 'flupyradifurone', 'imidacloprid'))
rnds <- 1:10
pdf('networks_by_treatment_round.pdf', width = 40, height=12)
dev.off()
#figures of foraging by treatment
ggplot(subset(counts, total > 0), aes(x = treatment, y = log10(total)))+
geom_boxplot(aes(color = treatment), show.legend = FALSE)+
scale_color_manual(values=c("grey", "purple", "orange"))+
theme_classic(base_size = 18)+
labs(y = "Total number of flowers visited per bee", x = "Treatment")+
# geom_signif(comparisons = list(c("imidacloprid","control")), map_signif_level = TRUE)+
stat_summary()
counts$specialization <- NA
rm(list = 'net.stats')
for(rnd in rnds){
for(trt in c("imidacloprid", "flupyradifurone", "control")){
ind <- which(counts$treatment == trt & counts$round == rnd)
sub.net <- counts[ind,2:4]
h2 <- H2fun(sub.net)[1]
dp <- dfun(sub.net)$dprime
counts$specialization[ind] <- dp
ns <- data.frame(h2, trt, rnd)
if(!exists('net.stats')){
net.stats <- ns
} else {
net.stats <- rbind(net.stats, ns)
}
View(counts)
ggplot(subset(counts, total > 0), aes(x = treatment, y = total))+
geom_boxplot(aes(color = treatment), show.legend = FALSE)+
scale_color_manual(values=c("grey", "purple", "orange"))+
theme_classic(base_size = 18)+
labs(y = "Total number of flowers visited per bee", x = "Treatment")+
# geom_signif(comparisons = list(c("imidacloprid","control")), map_signif_level = TRUE)+
stat_summary()
ggplot(subset(counts, total > 0), aes(x = treatment, y = specialization))+
